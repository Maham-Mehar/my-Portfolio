# ── LLM provider ─────────────────────────────────────────────────────────────
# "openai" (OpenAI or any OpenAI-compatible API) or "gemini". Leave empty to run
# without AI — data endpoints still work and the site shows a clear setup state.
LLM_PROVIDER=
LLM_API_KEY=
# Pick a current model from your provider's model list, e.g. a small, fast chat model.
LLM_MODEL=
# Only for OpenAI-compatible providers other than OpenAI (Groq, OpenRouter, Ollama…)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Security & limits ────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:3000
# Set to true only behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
LLM_TIMEOUT_SECONDS=25
LLM_MAX_OUTPUT_TOKENS=600
